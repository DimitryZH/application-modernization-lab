FROM python:3.12-slim
RUN pip install --no-cache-dir grpcio==1.76.0 grpcio-tools==1.76.0 requests==2.32.4 pyyaml==6.0.3
WORKDIR /validation
COPY scenarios.py faults.py redis_probe.py ./
ARG SOURCE_REVISION=development
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ARG TOOLING_REVISION=development
LABEL online-shop.validation.revision=$TOOLING_REVISION
