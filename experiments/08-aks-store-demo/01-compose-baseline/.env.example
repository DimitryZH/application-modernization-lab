# Experiment 08A default profile requires no external AI credentials.
COMPOSE_PROJECT_NAME=aks-store-demo-compose
FRONTEND_URL=http://127.0.0.1:8080
ADMIN_URL=http://127.0.0.1:8081

# Optional ai profile only. Do not commit real values.
USE_AZURE_OPENAI=True
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
AZURE_OPENAI_IMAGE_DEPLOYMENT_NAME=
AZURE_OPENAI_IMAGE_ENDPOINT=
OPENAI_API_KEY=
OPENAI_ORG_ID=
